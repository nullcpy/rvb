# Normalize line endings: shell/python/workflow/data files are LF everywhere
# (Windows checkouts with core.autocrlf=true otherwise inject CRLF and break
# WSL/Linux execution + byte-comparison of trace goldens).
* text=auto

*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.trace text eol=lf
*.md text

*.jar binary
*.keystore binary
*.apk binary
*.zip binary
*.png binary
*.svg text
